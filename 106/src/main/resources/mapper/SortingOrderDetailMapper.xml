<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fishing.distribution.mapper.SortingOrderDetailMapper">

    <select id="selectByOrderId" resultType="com.fishing.distribution.entity.SortingOrderDetail">
        SELECT * FROM sorting_order_detail
        WHERE order_id = #{orderId}
        AND deleted = 0
        ORDER BY id ASC
    </select>

</mapper>
