<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fishing.distribution.mapper.FishingBoatMapper">

    <select id="selectBoatsWithExpiringLicense" resultType="com.fishing.distribution.entity.FishingBoat">
        SELECT * FROM fishing_boat
        WHERE license_expire_date BETWEEN #{startDate} AND #{endDate}
        AND deleted = 0
        ORDER BY license_expire_date ASC
    </select>

</mapper>
