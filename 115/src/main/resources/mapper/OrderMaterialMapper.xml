<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zongshi.brush.mapper.OrderMaterialMapper">

    <select id="selectByOrderId" resultType="com.zongshi.brush.entity.OrderMaterial">
        SELECT * FROM order_material
        WHERE order_id = #{orderId}
